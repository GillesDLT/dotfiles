# KEYBINDINGS #
# See https://wiki.hyprland.org/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier

# See https://wiki.hyprland.org/Configuring/Binds/
## Main keybinds
bind = $mainMod, Q, killactive,     # Close the window
bind = $mainMod, L, exec, /home/gilles/.config/hypr/scripts/rofi-power-menu.sh     # Shutdown

## Navigate focus between windows
bind = $mainMod, left, movefocus, l     # Change focus
bind = $mainMod, right, movefocus, r    # Change focus
bind = $mainMod, up, movefocus, u       # Change focus
bind = $mainMod, down, movefocus, d     # Change focus

## Apps
bind = $mainMod, Return, exec, $terminal# Open the terminal
bind = $mainMod, E, exec, $menu         # App finder
bind = $mainMod, O, exec, $fileManager  # Open the file manager
bind = $mainMod CTRL, O, exec, dolphin  # Open Dolphin file manager
bind = $mainMod, B, exec, zen-browser   # Open the browser
bind = $mainMod, K, exec, kwrite        # Open the txt editor
bind = $mainMod, W, exec, networkmanager_dmenu -theme ~/.config/rofi/network.rasi   # Wifi manager

## Windows management
bindm = $mainMod, mouse:272, movewindow     # Move windows
bindm = $mainMod, mouse:273, resizewindow   # Resize windows
bind = $mainMod, V, togglefloating, # Toggle floating
bind = $mainMod, P, pseudo,         # Toggle minimized
bind = $mainMod, F11, fullscreen, toggle  # Toggle fullscreen
bind = $mainMod, J, togglesplit,    # Toggle Split

## Switch workspaces
bind = $mainMod, mouse_down, exec, ~/.config/hypr/scripts/smart_workspace_scroll.sh -1  # Scroll through existing workspaces
bind = $mainMod, mouse_up, exec, ~/.config/hypr/scripts/smart_workspace_scroll.sh 1     # Scroll through existing workspaces
bind = $mainMod, 1, workspace, 1    # Switch to 1
bind = $mainMod, 2, workspace, 2    # Switch to 2
bind = $mainMod, 3, workspace, 3    # Switch to 3
bind = $mainMod, 4, workspace, 4    # Switch to 4
bind = $mainMod, 5, workspace, 5    # Switch to 5
bind = $mainMod, 6, workspace, 6    # Switch to 6
bind = $mainMod, 7, workspace, 7    # Switch to 7
bind = $mainMod, 8, workspace, 8    # Switch to 8
bind = $mainMod, 9, workspace, 9    # Switch to 9
bind = $mainMod, 0, workspace, 10   # Switch to 10

## Move active window to workspace n
bind = $mainMod SHIFT, 1, movetoworkspace, 1    # Move to 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2    # Move to 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3    # Move to 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4    # Move to 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5    # Move to 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6    # Move to 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7    # Move to 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8    # Move to 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9    # Move to 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10   # Move to 10

## Screenshot
bind = $mainMod, F2, exec, grim -g "$(slurp -c B4BEFEAA -b 1A1B2699)" - | wl-copy && notify-send "📸 Screenshot 🖼️" "Screenshot copied to clipboard" # take a screenshot
bind = $mainMod Shift, F2, exec, mkdir -p ~/Images/Screenshots && grim -g "$(slurp -c B4BEFEAA -b 1A1B2699)" ~/Images/Screenshots/screenshot_$(date +'%d-%m-%Y_%Hh-%Mm-%Ss').png && notify-send "📸 Screenshot 💾" "Screenshot saved to  ~/Images/Screenshots !"

## Notifications
bind = SUPER, Y, exec, notify-send "Hello!" "This is a test notification." -u normal
bind = SUPER, U, exec, notify-send "Warning!" "This is a critical notification!" -u critical


## Multimedia
bindel = ,XF86AudioRaiseVolume, exec, ~/.config/hypr/scripts/volume_notify.sh up    # Raise Volume
bindel = ,XF86AudioLowerVolume, exec, ~/.config/hypr/scripts/volume_notify.sh down  # Lower Volume

bindel = ,XF86MonBrightnessUp, exec, ~/.config/hypr/scripts/brightness_notify.sh up     # Brightness Up
bindel = ,XF86MonBrightnessDown, exec, ~/.config/hypr/scripts/brightness_notify.sh down # Brightness Down

bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle           # Mute
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle      # Mic Mute
bindl = , XF86AudioNext, exec, playerctl next       # Next
bindl = , XF86AudioPause, exec, playerctl play-pause# Pause
bindl = , XF86AudioPlay, exec, playerctl play-pause # Play
bindl = , XF86AudioPrev, exec, playerctl previous   # Previous

## Misc
# Example special workspace (scratchpad)
#bind = $mainMod, S, togglespecialworkspace, magic
#bind = $mainMod SHIFT, S, movetoworkspace, special:magic
#bind = $mainMod, G, exec, /home/gilles/.config/hypr/scripts/lock.sh    # Lockscreen the window
